    "option": {
        "起号账号标识": {
            "type": "input",
            "description": "必填非敏感账号代号；同实例换号必须修改。不是密码，也不会用于自动登录。",
            "inputs": [
                {
                    "name": "起号账号代号",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "起号工作流配置": {
                    "attach": {
                        "account": "{起号账号代号}"
                    }
                }
            }
        },
        "起号动作时序": {
            "type": "select",
            "default_case": "上游等待",
            "cases": [
                {
                    "name": "上游等待",
                    "label": "上游时序（默认）",
                    "pipeline_override": {
                        "起号工作流配置": {
                            "attach": {
                                "timing_mode": "post_click"
                            }
                        }
                    }
                },
                {
                    "name": "绝对时间轴",
                    "label": "绝对时间轴（需要逐关校准）",
                    "pipeline_override": {
                        "起号工作流配置": {
                            "attach": {
                                "timing_mode": "absolute"
                            }
                        }
                    }
                }
            ]
        },
        "起号校准参数": {
            "type": "input",
            "description": "首段等待0～10000ms，间隔偏移-500～500ms；默认不做修正，不套用3v3参数。",
            "inputs": [
                {
                    "name": "起号首段等待",
                    "default": "0",
                    "pipeline_type": "int"
                },
                {
                    "name": "起号间隔偏移",
                    "default": "0",
                    "pipeline_type": "int"
                }
            ],
            "pipeline_override": {
                "起号工作流配置": {
                    "attach": {
                        "initial_delay_ms": "{起号首段等待}",
                        "interval_offset_ms": "{起号间隔偏移}"
                    }
                }
            }
        },
        "起号手动确认重试": {
            "type": "switch",
            "default_case": "No",
            "description": "仅在人工核对当前页面、召唤/强化等步骤后开启；将重跑未完成阶段入口。不要长期保持开启。已完成阶段仍不会重跑。",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "起号工作流配置": {
                            "attach": {
                                "retry": false
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "起号工作流配置": {
                            "attach": {
                                "retry": true
                            }
                        }
                    }
                }
            ]
        }
    }
}
