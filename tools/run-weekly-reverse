#!/usr/bin/env bash
# 单独跑每周逆袭悬赏（入口 每周逆袭悬赏entry）。
# 使用 deps/.run-test，不写主配置 / 主日志。
# 默认沿用主配置里该任务的选项；没有则用「逆袭A和逆袭S」+ 残卷进出刷新 Yes。
#
#   ./tools/run-weekly-reverse
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="/home/linn/MaaPiCli/build/bin/RelWithDebInfo"
WORK="${ROOT}/deps/.run-test"
MAIN_CFG="${ROOT}/deps/bin/config/maa_pi_config.json"

export PYTHONPATH="${ROOT}/agent${PYTHONPATH:+:${PYTHONPATH}}"
"${ROOT}/.venv/bin/python" -c 'from utils.waydroid_host import ensure_waydroid_and_adb; ensure_waydroid_and_adb()'

mkdir -p "${WORK}/config" "${WORK}/debug" "${WORK}/plugins"
cp -a "${SRC}/MaaPiCli" "${WORK}/MaaPiCli"
shopt -s nullglob
for lib in "${SRC}"/*.so "${SRC}"/*.so.*; do
    ln -sfn "${lib}" "${WORK}/$(basename "${lib}")"
done
shopt -u nullglob
ln -sfn "${ROOT}/assets/interface.json" "${WORK}/interface.json"
ln -sfn "${ROOT}/assets/resource" "${WORK}/resource"
cp -a "${ROOT}/deps/bin/config/." "${WORK}/config/"

MAIN_CFG="${MAIN_CFG}" "${ROOT}/.venv/bin/python" - <<'PY'
import json
import os
from pathlib import Path

cfg = Path("/home/linn/MR3A/deps/.run-test/config/maa_pi_config.json")
data = json.loads(cfg.read_text(encoding="utf-8"))
default_option = [
    {
        "inputs": {},
        "name": "选择要打的逆袭boss",
        "value": "逆袭A和逆袭S",
        "values": [],
    },
    {
        "inputs": {},
        "name": "残卷兑换进出刷新",
        "value": "Yes",
        "values": [],
    },
]
option = default_option
main_cfg = Path(os.environ["MAIN_CFG"])
if main_cfg.is_file():
    main = json.loads(main_cfg.read_text(encoding="utf-8"))
    for task in main.get("task", []):
        if task.get("name") == "每周逆袭悬赏":
            option = task.get("option") or default_option
            break

data["task"] = [{"name": "每周逆袭悬赏", "option": option}]
cfg.write_text(json.dumps(data, ensure_ascii=False, indent=4) + "\n", encoding="utf-8")
print("已写入测试任务: 每周逆袭悬赏 → 每周逆袭悬赏entry")
for opt in option:
    print(f"  option {opt.get('name')} = {opt.get('value')}")
PY

export MR3A_TEST_WORK="${WORK}"
cd "${WORK}"
exec ./MaaPiCli -d
